#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        // zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E          &kp R  &kp T        &kp Y    &kp U  &kp I          &kp O    &kp P     &kp ESCAPE
&kp LEFT_COMMAND  &kp A  &kp S  &kp D          &kp F  &kp G        &kp H    &kp J  &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT         &kp Z  &kp X  &kp C          &kp V  &kp B        &kp N    &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp RIGHT_ALT  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp BACKSPACE
            >;
        };

        lower_layer {
            bindings = <
&trans  &trans   &kp N7  &kp N8    &kp N9  &kp LG(X)        &trans    &trans     &trans          &trans        &trans     &trans
&trans  &kp N0   &kp N4  &kp N5    &kp N6  &kp LC(LG(C))    &kp HOME  &kp LEFT   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp END
&trans  &kp DOT  &kp N1  &kp N2    &kp N3  &kp LC(LG(V))    &kp PLUS  &kp MINUS  &kp KP_EQUAL    &kp STAR      &kp SLASH  &trans
                         &kp LGUI  &trans  &kp SPACE        &kp RET   &mo 3      &kp BACKSPACE
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTRK  &kp CARET  &kp AMPERSAND  &kp GRAVE
&kp F1  &kp F2    &kp F3  &kp F4    &kp F5    &kp F6       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp MINUS  &kp EQUAL  &kp BSLH       &kp STAR
&kp F7  &kp F8    &kp F9  &kp F10   &kp F11   &kp F12      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDER  &kp PLUS   &kp PIPE       &kp TILDE
                          &kp LGUI  &mo 3     &kp SPACE    &kp RET               &trans                 &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp PRINTSCREEN  &kp K_MUTE  &kp C_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOLUME_UP  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans           &trans      &trans            &trans        &trans           &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans           &trans      &trans            &trans        &trans           &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET          &trans      &trans
            >;
        };
    };
};
